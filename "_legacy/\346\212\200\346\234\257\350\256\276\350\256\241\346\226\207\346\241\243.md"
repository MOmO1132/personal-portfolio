```
personal-site/
├── index.html              # 页面骨架 + SVG 图标精灵 + SEO meta
├── docs/
│   ├── PRD.md              # 需求文档
│   └── 技术设计文档.md      # 本文档
└── assets/
    ├── css/
    │   └── style.css       # 全部样式（变量区 / 布局 / 组件 / 动效 / 响应式）
    ├── js/
    │   ├── content.js      # ★ 唯一需要改的内容文件（文案/图片/链接/项目数据）
    │   └── main.js         # 渲染函数 + 交互逻辑（一般不需要改）
    └── img/                # 头像、项目封面等图片
```

